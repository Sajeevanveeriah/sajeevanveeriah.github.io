{
  "name": "sajeevanveeriah-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "My engineering portfolio: a static Next.js export deployed to Cloudflare Workers, with a GitHub Pages redirect mirror.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "next build",
    "postbuild": "node scripts/generate-redirects.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs",
    "cloudflare:login": "wrangler login",
    "cloudflare:check": "wrangler deploy --config wrangler.jsonc --dry-run",
    "cloudflare:deploy": "wrangler deploy --config wrangler.jsonc",
    "qa:export": "node scripts/verify-export.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "pages:mirror": "node scripts/build-pages-mirror.mjs"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "axe-core": "^4.12.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.23",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.0",
    "typescript": "^5.9.2",
    "wrangler": "4.135.0"
  }
}
