{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sv",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
