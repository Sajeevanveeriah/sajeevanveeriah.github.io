{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sajeevanveeriah.github.io/open-industrial-automation/schemas/oia-project.schema.json",
  "title": "Open Industrial Automation Project",
  "type": "object",
  "required": ["meta", "modules", "hierarchy", "assets", "tags", "alarms", "recipes", "requirements", "tests"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "projectName", "timezone", "unitSystem", "release", "licence", "safetyBoundary"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "projectId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 },
        "unitSystem": { "enum": ["SI"] },
        "release": { "type": "string", "minLength": 1 },
        "licence": { "type": "string", "minLength": 1 },
        "safetyBoundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identified" } },
    "hierarchy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identified" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/identified" } },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/identified" } },
    "alarms": { "type": "array", "items": { "$ref": "#/$defs/identified" } },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/identified" } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/identified" } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/identified" } }
  },
  "$defs": {
    "identified": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
